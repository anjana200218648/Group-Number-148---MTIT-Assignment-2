# Frontend API configuration
# Use the API gateway:
# - http://localhost:8080 serves the gateway
# - all service endpoints are under /api/*
VITE_API_BASE_URL=http://localhost:8080
VITE_API_PREFIX=/api

# To bypass the gateway and call the microservice directly:
# VITE_API_BASE_URL=http://localhost:8082
# VITE_API_PREFIX=

